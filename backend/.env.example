# Copy this file to .env and fill in real values
# NEVER commit the .env file

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a strong random secret (64+ chars)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRE=30d

# Cloudinary — get from cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Allowed CORS origins
ADMIN_ORIGIN=https://your-admin.vercel.app
CLIENT_ORIGIN=exp://

# SMTP Email Configuration (e.g., Brevo / Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=Local PCO <noreply@localpco.com>
FROM_EMAIL=Local PCO <noreply@localpco.com>

